PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clockin_system
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
QR_ROTATION_MINUTES=5
TOKEN_EXPIRY_MINUTES=60

# Organization timezone for auto clock-out (IANA name, e.g. Africa/Blantyre for Malawi)
# APP_TIMEZONE=Africa/Blantyre

# ── Production / Render ──────────────────────────────────────────────────
# NODE_ENV=production
# DB_SSL=true                 # Required for TiDB Cloud (uses SSL)

# FRONTEND_URL is optional. Leave it unset for development (the backend will
# auto-detect the origin from the browser request). Only set it in production
# when the frontend is served from a known domain, e.g.:
# FRONTEND_URL=https://clockin.yourcompany.com

# ── TiDB Cloud example ──────────────────────────────────────────────────
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxxx.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=clockin_system
# DB_SSL=true

# ── Outbound email (password reset, etc.) ────────────────────────────────
# Option A — Resend (recommended on Render): uses HTTPS, no SMTP ports needed.
# Sign up at https://resend.com, create an API key, then set:
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Emerge Livelihoods <onboarding@resend.dev>   # or your verified domain
#
# Option B — SMTP (e.g. Gmail): often blocked on cloud hosts (connection timeout).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=your@gmail.com
