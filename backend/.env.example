PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clockin_system
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
QR_ROTATION_MINUTES=5
TOKEN_EXPIRY_MINUTES=60

# ── Production / Render ──────────────────────────────────────────────────
# NODE_ENV=production
# DB_SSL=true                 # Required for TiDB Cloud (uses SSL)

# FRONTEND_URL is optional. Leave it unset for development (the backend will
# auto-detect the origin from the browser request). Only set it in production
# when the frontend is served from a known domain, e.g.:
# FRONTEND_URL=https://clockin.yourcompany.com

# ── TiDB Cloud example ──────────────────────────────────────────────────
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxxx.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=clockin_system
# DB_SSL=true

# ── Outbound email (password reset, etc.) ────────────────────────────────
# Configure these if you want the system to send real emails. In development
# you can leave them unset; the backend will log a warning and skip sending.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false           # true for port 465, false for 587/STARTTLS
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM_EMAIL=no-reply@yourcompany.com
